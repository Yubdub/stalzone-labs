# Set these as environment variables; never commit real credentials.
EXBO_CLIENT_ID=
EXBO_CLIENT_SECRET=
# Alternatively: EXBO_TOKEN=

# Render: attach a disk at /var/data and use this directory.
MARKET_CACHE_DIR=/var/data/market-cache
# Optional custom domain, including https://
# PUBLIC_URL=https://your-domain.example

# Server-only market collection: six-hour freshness, >=1 second between upstream requests.
MARKET_REFRESH_INTERVAL_MS=21600000
ARTIFACT_REQUEST_DELAY_MS=1500
MARKET_REFRESH_ENABLED=true
